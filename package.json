{
  "name": "mioshie-college",
  "version": "1.0.0",
  "description": "Mioshie College — Ensinamentos de Meishu-Sama",
  "main": "sw.js",
  "scripts": {
    "build:css": "postcss css/styles.css --config postcss.config.cjs -o css/styles.min.css",
    "build:admin-css": "postcss css/admin.css --config postcss.config.cjs -o css/admin.min.css",
    "build:js": "esbuild js/playlists.js js/highlights.js js/disciples-reader.js js/reader-render.js js/search.js --minify --charset=utf8 --outdir=js --out-extension:.js=.min.js",
    "watch:css": "postcss css/styles.css --config postcss.config.cjs -o css/styles.min.css --watch",
    "build": "npm run build:css && npm run build:admin-css && npm run build:js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:render": "node scripts/render_regress.mjs",
    "versions": "node scripts/bump-versions.mjs",
    "build:titles": "node scripts/build_titles_index.mjs",
    "split:index": "node scripts/split_search_index.js",
    "storage:pull": "node scripts/storage-pull.mjs",
    "storage:status": "node scripts/storage-status.mjs",
    "storage:push": "node scripts/storage-push.mjs"
  },
  "keywords": [
    "meishu-sama",
    "ensinamentos",
    "mioshie"
  ],
  "author": "Ymika",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "cssnano": "^7.1.4",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3"
  }
}
